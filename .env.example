NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false

# Publicité EXCI uniquement. N'activer qu'après avoir configuré une CMP certifiée
# dans AdSense pour les visiteurs de l'EEE, du Royaume-Uni et de la Suisse.
NEXT_PUBLIC_ADSENSE_ENABLED=false
NEXT_PUBLIC_ADSENSE_CLIENT=
NEXT_PUBLIC_ADSENSE_HOME_SLOT=

# Adresse publique requise avant de publier la politique de confidentialite.
NEXT_PUBLIC_PRIVACY_CONTACT_EMAIL=

# Notifications serveur des signalements de questions (jamais exposees au navigateur).
RESEND_API_KEY=
EXCI_REPORT_TO_EMAIL=contact@pigeons.click
EXCI_REPORT_FROM_EMAIL=EXCI <notifications@pigeons.click>
